# Copy this file to ".env" and edit if needed.

# Local MongoDB (default when MongoDB Community Server is installed):
MONGODB_URI=mongodb://127.0.0.1:27017/restovault

# MongoDB Atlas (cloud) looks like this instead:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/restovault?retryWrites=true&w=majority

PORT=5000

# Admin credentials for the + button on the home page (change these before use)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123
ADMIN_TOKEN_SECRET=password123456

